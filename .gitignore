node_modules/
.env
*.log
auth.json
deepseek-auth.json
# Aggregate account export holding live tokens/cookies — never commit.
deepseek-accounts.json
# Runtime-added auth files contain secrets — keep the dir, ignore its contents.
data/accounts/*.json
.chrome-profile-deepseek/
.chrome-for-testing-profile-deepseek/
.chrome-for-testing-profile-deepseek.stale-*/
*.session.json
/tmp/deepseek_response_*
.DS_Store
*.pdf
# Live session map (chat ids, restored on restart) — never commit.
.sessions.json
# Live DeepSeek auth tokens/cookies (0600) — never commit. Keep the dir.
accounts/*.json
accounts/.*
# Quarantined (suspended/expired) account files — also secrets, never commit.
accounts-quarantined-*/*.json
accounts-quarantined-*/.*
# Credential backups the auth CLI writes — same secrets as the .json files.
accounts/*.bak
accounts/*.bak-*
accounts-quarantined-*/*.bak
accounts-quarantined-*/*.bak-*
data/accounts/*.bak
# Live browser profile (cookies, session state) — never commit.
.chrome-profile-second/
# Proxy restart state (starting account rotation) — never commit.
.proxy-state.json
.proxy-state.json.tmp
*.proxy-state.json
