# FreeDeepseekAPI — example configuration.
# This is a CURATED SUBSET of the supported variables, showing the values the
# code uses by default. The full, authoritative list of knobs lives in
# README.md; this file only covers the ones most deployments touch.
# Copy this file to .env and override as needed (a real .env is gitignored).

# ── HTTP server ──
PORT=9655
# Loopback-only by default. Use 0.0.0.0 only when remote access is intentional.
# A non-loopback HOST with no proxy key refuses to start; set this to 1 to
# override that guard and run an unauthenticated, network-reachable proxy.
ALLOW_INSECURE_REMOTE=0
HOST=127.0.0.1
# Optional bearer token required by every non-health endpoint. Strongly
# recommended whenever HOST is not a loopback address.
# PROXY_API_KEY=replace-with-a-long-random-value
# Read the bearer token from a mounted secret instead of the environment.
# The file is read once and cached for the process lifetime: rotating the
# secret on disk requires a restart to take effect.
# PROXY_API_KEY_FILE=/run/secrets/proxy-api-key
# Fail startup when neither key source is set (enabled by Containerfile).
REQUIRE_PROXY_API_KEY=0
# Browser requests are accepted from loopback origins. Add exact remote UI
# origins as a comma-separated allowlist when needed.
# PROXY_CORS_ORIGINS=https://ui.example.com,http://192.168.1.20:3000
# Detailed account/session status stays private unless the caller presents
# PROXY_API_KEY. Setting this to 1 exposes details to every status caller,
# including remote callers; prefer the API key or network isolation.
DEEPSEEK_PUBLIC_STATUS=0

# ── Account auth source ──
# The pool loads DeepSeek accounts from files. Use either a single file or a
# directory of *.json files (one account per file).
DEEPSEEK_AUTH_PATH=./deepseek-auth.json
# DEEPSEEK_AUTH_DIR=./data/accounts

# ── Account pool ──
# HTTP 429 cooldown in milliseconds (default: 600000 = 10 minutes). HTTP
# 401/403 marks credentials unavailable and is not a timed cooldown.
DEEPSEEK_ACCOUNT_COOLDOWN_MS=600000
# Maximum concurrent completion turns across the whole pool (positive integer,
# default: 24). Body upload and in-flight sub-turn HTTP calls are not counted.
DEEPSEEK_MAX_CONCURRENT=24
# Maximum simultaneous leases per account (integer 0-10, default: 1). A lease
# covers the complete upstream turn, including streaming and in-place retries.
# Set to 0 to disable only the per-account ceiling.
DEEPSEEK_MAX_PER_ACCOUNT=1

# ── Long agent sessions ──
# Maximum characters sent to DeepSeek Web after compacting old context.
# Lower this if the Web endpoint reports that the content is too long.
DEEPSEEK_MAX_PROMPT_CHARS=80000
# In-place retries for an empty/context-too-long response (default: 2).
DEEPSEEK_MAX_RETRIES=2

# ── Anti-suspension / pacing ──
# Everything below shapes how fast the proxy talks to DeepSeek Web. All values
# are milliseconds or counts; defaults are the shipped code defaults.
# Requests allowed per account in a rolling hour (0 disables the quota).
DEEPSEEK_HOURLY_QUOTA=60
# Extra per-account requests allowed per minute on top of the hourly quota
# (0 disables the burst allowance). 15 is the shipped default: it leaves
# ~1.5-2x headroom over the pacer's normal rate while still cutting a flood.
DEEPSEEK_BURST_PER_MINUTE=15
# Minimum gap between consecutive agent-loop turns against one account.
DEEPSEEK_AGENT_TURN_GAP_MS=6000
# Random extra jitter (0..N ms) added to each pacing gap.
DEEPSEEK_TURN_JITTER_MS=2000
# Do not start a turn when less than this much of the request deadline is left.
DEEPSEEK_MIN_USABLE_UPSTREAM_MS=10000
# Total wall-clock budget for one inbound completion request.
DEEPSEEK_REQUEST_DEADLINE_MS=120000
# Per-request upstream HTTP timeout for a single DeepSeek Web call.
DEEPSEEK_FETCH_TIMEOUT_MS=60000
# Interval between ambient telemetry pings (minimum 60000).
DEEPSEEK_TELEMETRY_INTERVAL_MS=900000
# Interval between advisory model-discovery refreshes (minimum 300000).
DEEPSEEK_MODEL_DISCOVERY_MS=3600000
# Account-scoring weights used to pick the next account.
DEEPSEEK_ROUTING_FAILURE_WEIGHT=4
DEEPSEEK_ROUTING_TIMEOUT_WEIGHT=12
DEEPSEEK_ROUTING_CONSECUTIVE_STRIKES=2
DEEPSEEK_ROUTING_ESCALATION_COOLDOWN_MS=60000
DEEPSEEK_ROUTING_FAILURE_HALFLIFE_MS=300000
DEEPSEEK_ROUTING_HOT_BONUS=2
DEEPSEEK_ROUTING_HOT_WINDOW_MS=60000

# ── Startup (deploy / CI) ──
# Set either to 1/true to start the proxy immediately and skip the menu.
NON_INTERACTIVE=0
SKIP_ACCOUNT_MENU=0
# Persist sessions and exit(1) on unhandled rejections/exceptions so systemd
# restarts clean (default: 1). Set to 0 for log-only mode while debugging.
DEEPSEEK_FATAL_ON_UNHANDLED=1

# ── Chrome auth helper (scripts/deepseek_chrome_auth.js) ──
# Path to a Chrome / Chrome-for-Testing binary (auto-detected when empty).
CHROME_PATH=
# Remote-debugging port for the auth browser (auto when empty).
DEEPSEEK_CHROME_PORT=
# Chrome profile directory (defaults to a temporary profile).
DEEPSEEK_CHROME_PROFILE=
# Keep the Chrome profile between runs (1/true).
DEEPSEEK_KEEP_CHROME_PROFILE=0
# Reuse an already-running Chrome instance (1/true).
DEEPSEEK_REUSE_CHROME=0

# ── Misc ──
# Pre-set a token for non-interactive auth import.
# DEEPSEEK_TOKEN=
# Run scripts/doctor.js without network checks (1/true).
# DOCTOR_OFFLINE=0
# Each online doctor account probe has a fixed 30-second timeout.
